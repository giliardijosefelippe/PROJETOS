# Lunardeli Engenharia — Conferência de Projetos
# Copie para .env.local e preencha. Nunca committe segredos.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# URL pública do app (Auth redirects, links em e-mails/relatórios)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase — projeto a provisionar externamente (não incluso neste repo)
# Dashboard → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Somente servidor (Route Handlers / Server Actions / jobs). NUNCA expor no browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# -----------------------------------------------------------------------------
# Storage — nomes dos buckets privados (criar no Supabase Storage)
# Policies devem restringir por organization_id / membership
# -----------------------------------------------------------------------------
STORAGE_BUCKET_LIBRARY=library
STORAGE_BUCKET_EVIDENCE=evidence
STORAGE_BUCKET_REPORTS=reports

# Limites de upload (bytes) — ajustar na Etapa B conforme política da empresa
# UPLOAD_MAX_BYTES_IMAGE=5242880
# UPLOAD_MAX_BYTES_PDF=20971520
# UPLOAD_MAX_BYTES_VIDEO=52428800

# -----------------------------------------------------------------------------
# Opcional — seed / demo (Etapa B+; não versionar senhas reais)
# -----------------------------------------------------------------------------
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=
# SEED_ORGANIZATION_NAME=Lunardeli Demo
