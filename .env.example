# Lunardeli Engenharia — Conferência de Projetos
# Copie para .env.local e preencha. Nunca committe segredos.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase — provisionar externamente (Dashboard → Project Settings → API)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Somente servidor (Route Handlers / Server Actions / seed). NUNCA no browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# -----------------------------------------------------------------------------
# Storage — buckets privados (criar via supabase/migrations/00003_storage.sql)
# Paths: {organization_id}/...
# -----------------------------------------------------------------------------
STORAGE_BUCKET_LIBRARY=library
STORAGE_BUCKET_EVIDENCE=evidence
STORAGE_BUCKET_REPORTS=reports

# Limites de upload (bytes) — referência; validação também no código
# UPLOAD_MAX_BYTES_IMAGE=5242880
# UPLOAD_MAX_BYTES_PDF=20971520
# UPLOAD_MAX_BYTES_VIDEO=52428800
# UPLOAD_MAX_BYTES_DRAWING=41943040

# -----------------------------------------------------------------------------
# CAD convert (Python / ezdxf) — DWG/DXF → PDF/PNG
# -----------------------------------------------------------------------------
# Suba o serviço: cd services/cad-convert && pip install -r requirements.txt
#   && uvicorn app.main:app --host 127.0.0.1 --port 8091
# Ver services/cad-convert/README.md (DWG exige ODA File Converter opcional).
CAD_CONVERT_URL=http://127.0.0.1:8091
# CAD_CONVERT_TIMEOUT_MS=120000
# No serviço Python (opcional):
# ODA_FILE_CONVERTER=ODAFileConverter
# CAD_CONVERT_MAX_BYTES=41943040

# -----------------------------------------------------------------------------
# Seed / demo (npm run seed) — não versionar senhas reais de produção
# -----------------------------------------------------------------------------
# SEED_ORGANIZATION_NAME=Lunardeli Demo
# SEED_ADMIN_EMAIL=admin@lunardeli.local
# SEED_ADMIN_PASSWORD=ChangeMe-Admin-123!
# SEED_COORD_EMAIL=coordenador@lunardeli.local
# SEED_COORD_PASSWORD=ChangeMe-Coord-123!
# SEED_DESENHISTA_EMAIL=desenhista@lunardeli.local
# SEED_DESENHISTA_PASSWORD=ChangeMe-Des-123!
# SEED_CONFERENTE_EMAIL=conferente@lunardeli.local
# SEED_CONFERENTE_PASSWORD=ChangeMe-Conf-123!
