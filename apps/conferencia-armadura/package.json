{
  "name": "conf-armadura",
  "version": "0.1.26-20261122",
  "private": true,
  "description": "CONF ARMADURA — HTML/mobile conferência de armadura in loco (PDF, relatório OK/risco, wake lock).",
  "type": "module",
  "scripts": {
    "www": "bash scripts/sync-www.sh",
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "npm run www",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "cap:sync": "npm run www && npx cap sync android",
    "cap:add:android": "npm run www && npx cap add android",
    "cap:android": "npm run cap:sync && npx cap open android",
    "apk:debug": "bash scripts/build-apk-versioned.sh",
    "pack:desktop": "bash scripts/pack-release.sh"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^5.0.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/share": "^6.0.3",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "typescript": "^7.0.2",
    "vite": "^6.0.7"
  }
}
